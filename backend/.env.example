# Copy this file to .env for local testing only — never commit a
# real .env. In production (Render), these are set as Environment
# Variables in the dashboard instead, per backend/README.md.

# From the Firebase service account JSON you generate in
# Project Settings > Service Accounts > Generate new private key:
PROJECT_ID=private-chat-7a103
CLIENT_EMAIL=firebase-adminsdk-xxxxx@private-chat-7a103.iam.gserviceaccount.com
# Keep the quotes and \n sequences exactly as they appear in the
# downloaded JSON's "private_key" field.
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Shared secret the Android app sends as the X-Api-Secret header.
# Generate any long random string for this, e.g.:
#   openssl rand -hex 32
API_SECRET=replace-with-a-long-random-string

PORT=10000

# Story music feature (search/trending/recommend) — optional. Without
# this set, those endpoints just return an empty song list rather than
# erroring, so the rest of the app works fine either way. Get a key
# from Google Cloud Console: enable the "YouTube Data API v3" on a
# project, then create an API key under Credentials.
YOUTUBE_API_KEY=
