<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Gallery access for Change DP. READ_MEDIA_IMAGES on API 33+;
         READ_EXTERNAL_STORAGE (capped at 32) covers older devices. On
         API 30+ with a recent Play services, the PickVisualMedia photo
         picker used in ChatActivity doesn't actually need either
         permission at all — these exist as the explicit fallback path
         requested, and so the app still works correctly on devices
         without the modern picker. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Same as above, for the chat camera-icon media picker's video option. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Voice messages -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Voice calls — same RECORD_AUDIO above covers the mic;
         MODIFY_AUDIO_SETTINGS is for the in-call speakerphone toggle. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Lets the incoming-call notification launch CallActivity as a
         full-screen UI (waking the screen / showing over the lock
         screen) instead of just sitting in the notification shade —
         this is what makes a call actually "ring" like a real call
         while the app is backgrounded or killed. Normal-protection
         permission, granted automatically; still must be declared. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- What actually keeps a call (and its audio) alive after leaving
         the app — CallForegroundService holds the process at
         foreground-service priority for the duration of an active
         call, WhatsApp-style. FOREGROUND_SERVICE_MICROPHONE is
         required alongside the service's own
         android:foregroundServiceType="microphone" on API 34+, or
         starting the foreground service throws at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <application android:name=".App"
        
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.PrivateChat"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.PrivateChat">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.chat.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.photo.PhotoViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoViewer" />

        <activity
            android:name=".ui.media.MediaPreviewActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoViewer"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.media.VideoViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoViewer" />

        <activity
            android:name=".ui.story.StoryUploadActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoViewer"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.story.StoryViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoViewer" />

        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:theme="@style/Theme.PhotoViewer"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <service
            android:name=".messaging.ChatFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Keeps an active call (and its audio) alive after leaving
             the app — see the service's own doc comment. -->
        <service
            android:name=".call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Decline action on the incoming-call notification — see the
             receiver's own doc comment. -->
        <receiver
            android:name=".call.CallDeclineReceiver"
            android:exported="false" />

        <!-- Hang Up action on the ongoing-call notification — see the
             receiver's own doc comment. -->
        <receiver
            android:name=".call.CallHangupReceiver"
            android:exported="false" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

    </application>

</manifest>
