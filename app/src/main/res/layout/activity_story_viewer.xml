<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <FrameLayout
        android:id="@+id/storyMediaWrap"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/storyImg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="Story" />

        <VideoView
            android:id="@+id/storyVid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Best-effort filter/adjust approximation for a video
             story's saved edit — a plain color scrim, not a pixel-
             accurate color-matrix (VideoView is a raw Surface with no
             color-filter hook). See StoryViewerActivity's own comment. -->
        <View
            android:id="@+id/storyFilterScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Draw + text/sticker overlay for a video story's saved edit
             — image stories need neither, since those are already
             flattened into the uploaded image itself. -->
        <com.privatechat.app.ui.story.StoryDrawView
            android:id="@+id/storyViewerDrawView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.privatechat.app.ui.story.StoryOverlayContainer
            android:id="@+id/storyViewerOverlayContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Text/sticker/draw overlay layer for video stories lands
             here in the editor PR — image edits are baked into the
             uploaded image itself so they need nothing at view time. -->

        <TextView
            android:id="@+id/storyCapOverlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="70dp"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:shadowColor="#CC000000"
            android:shadowRadius="8"
            android:visibility="gone" />

        <!-- Music sticker pill — shown when the story has a selected
             song, matching Instagram's own music-sticker look. -->
        <LinearLayout
            android:id="@+id/storyMusicBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="120dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_story_toolbar_button"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/storyMusicBadgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxWidth="180dp"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:singleLine="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:selected="true"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Hidden host for StoryMusicPlayer's YouTube WebView during
             playback — must stay attached to the window (see the
             player's own comment). -->
        <FrameLayout
            android:id="@+id/storyMusicPlaybackContainer"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:layout_gravity="top|start" />
    </FrameLayout>

    <!-- Progress bars -->
    <LinearLayout
        android:id="@+id/storyProgressBars"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingTop="10dp" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/storyViewerAvatar"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_media_thumb_placeholder"
            android:contentDescription="Poster" />

        <TextView
            android:id="@+id/storyViewerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:shadowColor="#B3000000"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/storyViewerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/storyDeleteBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_trash"
            android:tint="@android:color/white"
            android:visibility="gone"
            android:contentDescription="Delete story" />

        <ImageButton
            android:id="@+id/storyCloseBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@android:color/white"
            android:contentDescription="Close" />
    </LinearLayout>

</FrameLayout>
