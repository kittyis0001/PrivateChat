<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_call_background"
    android:gravity="center_horizontal"
    android:paddingTop="64dp"
    android:paddingBottom="40dp">

    <ImageView
        android:id="@+id/callAvatar"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:contentDescription="Caller photo" />

    <TextView
        android:id="@+id/callName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/callStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Incoming-ringing: Decline / Accept (shown only while ringing). -->
    <LinearLayout
        android:id="@+id/callIncomingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="56dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/callDeclineButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_decline_ripple"
                android:src="@drawable/ic_call_end"
                android:scaleType="center"
                android:contentDescription="Decline" />

            <TextView
                android:id="@+id/callDeclineLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Decline"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageButton
                android:id="@+id/callAcceptButton"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_accept_ripple"
                android:src="@drawable/ic_call_accept"
                android:scaleType="center"
                android:contentDescription="Accept" />

            <TextView
                android:id="@+id/callAcceptLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Accept"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Connected-state controls: Mute + Speaker (shown once active). -->
    <LinearLayout
        android:id="@+id/callInProgressControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="28dp">

                <ImageButton
                    android:id="@+id/callMuteButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_call_control_ripple"
                    android:src="@drawable/ic_mic"
                    android:scaleType="center"
                    android:contentDescription="Mute" />

                <TextView
                    android:id="@+id/callMuteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Mute"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="28dp">

                <ImageButton
                    android:id="@+id/callSpeakerButton"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_call_control_ripple"
                    android:src="@drawable/ic_speaker"
                    android:scaleType="center"
                    android:contentDescription="Speaker" />

                <TextView
                    android:id="@+id/callSpeakerLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Speaker"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Shared end-call button (dialing / connecting / active). -->
    <LinearLayout
        android:id="@+id/callEndSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:visibility="visible">

        <ImageButton
            android:id="@+id/callEndButton"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_call_decline_ripple"
            android:src="@drawable/ic_call_end"
            android:scaleType="center"
            android:contentDescription="End call" />

        <TextView
            android:id="@+id/callEndLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="End call"
            android:textColor="@android:color/white"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
