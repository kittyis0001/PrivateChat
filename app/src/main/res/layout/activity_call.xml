<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/black"
    android:gravity="center_horizontal"
    android:paddingTop="72dp"
    android:paddingBottom="48dp">

    <ImageView
        android:id="@+id/callAvatar"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="Caller photo" />

    <TextView
        android:id="@+id/callName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/callStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#B3FFFFFF"
        android:textSize="15sp" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Connected-state controls: mute + speaker, shown alongside the
         shared end-call button below. -->
    <LinearLayout
        android:id="@+id/callInProgressControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="28dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/callMuteButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_call_control_button"
            android:src="@drawable/ic_mic"
            android:contentDescription="Mute" />

        <ImageButton
            android:id="@+id/callSpeakerButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_call_control_button"
            android:src="@drawable/ic_speaker"
            android:contentDescription="Speaker" />
    </LinearLayout>

    <!-- Incoming-ringing controls: decline / accept, replaces the
         shared end-call button while ringing on the receiving side. -->
    <LinearLayout
        android:id="@+id/callIncomingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingHorizontal="48dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/callDeclineButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_call_decline_button"
            android:src="@drawable/ic_call_end"
            android:contentDescription="Decline" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/callAcceptButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_call_accept_button"
            android:src="@drawable/ic_call" />
    </LinearLayout>

    <!-- Shared end-call button: outgoing-ringing, connecting, and
         connected states all show just this (accept/decline above is
         only for the incoming-ringing state). -->
    <ImageButton
        android:id="@+id/callEndButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_call_decline_button"
        android:src="@drawable/ic_call_end"
        android:contentDescription="End call" />

</LinearLayout>
