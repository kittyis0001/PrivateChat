<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/driveBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/notes_drive_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/textPrimary"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_intro"
                android:textSize="13sp"
                android:textColor="@color/textSecondary" />

            <TextView
                android:id="@+id/driveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/driveAccount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/driveLastBackup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/driveProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveConnectBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_connect"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveBackupBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_backup_now"
                android:layout_marginTop="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveRestoreBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_restore"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginTop="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveSignOutBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_sign_out"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginTop="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_setup_label"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="28dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_package_label"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/drivePackageValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/textPrimary"
                android:textIsSelectable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_sha_label"
                android:textSize="12sp"
                android:textColor="@color/textSecondary"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/driveShaValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/textPrimary"
                android:textIsSelectable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/driveCopyShaBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_drive_copy_sha"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
