<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2000000">

    <LinearLayout
        android:id="@+id/storyRootColumn"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/storyHeaderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add to Your Story"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:layout_marginBottom="18dp" />

        <!-- Preview + edit layers: base media, draw layer, draggable
             text/sticker layer, then the Edit toggle + right-side
             toolbar (music button lands here in the next PR). -->
        <FrameLayout
            android:id="@+id/storyPreviewWrap"
            android:layout_width="220dp"
            android:layout_height="360dp">

            <ImageView
                android:id="@+id/storyPreviewImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_story_preview"
                android:visibility="gone"
                android:contentDescription="Story preview" />

            <VideoView
                android:id="@+id/storyPreviewVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.privatechat.app.ui.story.StoryDrawView
                android:id="@+id/storyDrawView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.privatechat.app.ui.story.StoryOverlayContainer
                android:id="@+id/storyOverlayContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/storyPickPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/bg_story_preview"
                android:text="📷"
                android:textSize="40sp" />

            <LinearLayout
                android:id="@+id/storyRightToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/storyEditToggleBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_story_toolbar_button"
                    android:src="@drawable/ic_menu_edit"
                    android:tint="@android:color/white"
                    android:contentDescription="Edit" />

                <TextView
                    android:id="@+id/storyMusicBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:background="@drawable/bg_story_toolbar_button"
                    android:text="🎵"
                    android:textSize="16sp"
                    android:contentDescription="Add music" />
            </LinearLayout>

            <!-- Selected-song badge, WhatsApp/Instagram-style pill —
                 shown once a song is picked, tap the ✕ to remove. -->
            <LinearLayout
                android:id="@+id/storySelectedMusicBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_margin="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_story_toolbar_button"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎵"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/storySelectedMusicText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxWidth="130dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@android:color/white"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/storyRemoveMusicBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="✕"
                    android:textColor="@android:color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Hidden host for StoryMusicPlayer's YouTube WebView
                 during in-picker preview — must stay attached to the
                 window to keep playing reliably (see the player's own
                 comment), so 1dp rather than not-added-at-all. -->
            <FrameLayout
                android:id="@+id/storyMusicPreviewContainer"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="top|start" />
        </FrameLayout>

        <EditText
            android:id="@+id/storyCaptionInput"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Add a caption…"
            android:textColorHint="#73FFFFFF"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_story_caption_input"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:maxLines="2"
            android:maxLength="120"
            android:inputType="textMultiLine|textCapSentences"
            android:visibility="gone" />

        <Button
            android:id="@+id/storyPickButton"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="📷  Choose Photo / Video"
            android:textColor="@android:color/white"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:background="@drawable/bg_story_pick_button" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/storyCancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="Cancel"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:paddingHorizontal="24dp"
                android:background="@drawable/bg_story_cancel_button" />

            <Button
                android:id="@+id/storyShareButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share Story"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingHorizontal="28dp"
                android:background="@drawable/bg_story_share_button"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Editor bottom panel — Filter/Text/Sticker/Draw/Adjust, same
         5 tools as story-editor.js's #storyEditorPanel. -->
    <LinearLayout
        android:id="@+id/storyEditorPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#EB000000"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/storyToolRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5"
            android:paddingTop="10dp"
            android:paddingBottom="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:paddingHorizontal="12dp"
            android:paddingBottom="14dp">

            <!-- Filter panel -->
            <HorizontalScrollView
                android:id="@+id/storyPanelFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">
                <LinearLayout
                    android:id="@+id/storyFilterList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Text panel -->
            <LinearLayout
                android:id="@+id/storyPanelText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <EditText
                        android:id="@+id/storyTextInput"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Type here…"
                        android:maxLength="60"
                        android:textColor="@android:color/white"
                        android:textColorHint="#80FFFFFF"
                        android:background="@drawable/bg_story_caption_input"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="8dp" />
                    <Button
                        android:id="@+id/storyTextAddBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Add"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_story_share_button" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <Spinner
                        android:id="@+id/storyFontSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                    <SeekBar
                        android:id="@+id/storyTextSizeSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:min="14"
                        android:max="60"
                        android:progress="24" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Color"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/storyTextColorRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Background"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/storyTextBgRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Animation"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                    <Spinner
                        android:id="@+id/storyAnimSpinner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Sticker panel -->
            <HorizontalScrollView
                android:id="@+id/storyPanelSticker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:visibility="gone">
                <LinearLayout
                    android:id="@+id/storyStickerRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Draw panel -->
            <LinearLayout
                android:id="@+id/storyPanelDraw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Color"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">
                    <LinearLayout
                        android:id="@+id/storyDrawColorRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <SeekBar
                        android:id="@+id/storyDrawSizeSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="2"
                        android:max="24"
                        android:progress="4" />
                    <Button
                        android:id="@+id/storyDrawUndoBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Undo"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_story_cancel_button" />
                    <Button
                        android:id="@+id/storyDrawClearBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Clear"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        android:background="@drawable/bg_story_cancel_button" />
                </LinearLayout>
            </LinearLayout>

            <!-- Adjust panel -->
            <LinearLayout
                android:id="@+id/storyPanelAdjust"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="☀️ Brightness"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/storyAdjBrightnessSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="50"
                        android:max="150"
                        android:progress="100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="◑ Contrast"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/storyAdjContrastSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="50"
                        android:max="150"
                        android:progress="100" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="🌫 Blur"
                        android:textColor="@android:color/white"
                        android:textSize="12sp" />
                    <SeekBar
                        android:id="@+id/storyAdjBlurSeek"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:min="0"
                        android:max="10"
                        android:progress="0" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Upload progress overlay, same pattern as MediaPreviewActivity's. -->
    <LinearLayout
        android:id="@+id/storyUploadOverlay2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <ProgressBar
            android:id="@+id/storyUploadSpinner"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Uploading…"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/storyUploadClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@android:color/white"
        android:contentDescription="Cancel" />

</FrameLayout>
