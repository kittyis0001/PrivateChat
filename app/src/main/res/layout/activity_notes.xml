<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notesDrawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Notes content -->
        <LinearLayout
            android:id="@+id/notesMainContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/background">

            <!-- Toolbar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@color/kittyHeaderBg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="10dp"
                android:elevation="2dp">

                <ImageButton
                    android:id="@+id/notesDrawerButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notes_drawer"
                    android:contentDescription="Menu" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/notes_title"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary"
                    android:layout_marginStart="4dp" />

                <ImageButton
                    android:id="@+id/notesCloudButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notes_cloud"
                    android:contentDescription="Sync" />

                <ImageButton
                    android:id="@+id/notesSearchButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_notes_search"
                    android:contentDescription="Search" />

                <ImageButton
                    android:id="@+id/notesOverflowButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_vert"
                    android:contentDescription="More" />
            </LinearLayout>

            <!-- Search bar -->
            <LinearLayout
                android:id="@+id/notesSearchBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:background="@color/surface"
                android:visibility="gone">

                <EditText
                    android:id="@+id/notesSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/notes_search_hint"
                    android:inputType="text"
                    android:background="@drawable/bg_input_field"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notesSearchClear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/notes_clear"
                    android:textColor="@color/primary"
                    android:padding="10dp" />
            </LinearLayout>

            <!-- Category chips -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notesChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:clipToPadding="false" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/notesList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="12dp"
                    android:clipToPadding="false" />

                <!-- Empty state -->
                <LinearLayout
                    android:id="@+id/notesEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="40dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="180dp"
                        android:layout_height="150dp"
                        android:src="@drawable/ic_empty_box"
                        android:contentDescription="Empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notes_empty_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notes_empty_body"
                        android:textSize="14sp"
                        android:textColor="@color/textSecondary"
                        android:gravity="center"
                        android:layout_marginTop="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/notesEmptyCreate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/notes_create_first"
                        android:layout_marginTop="20dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- FAB -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/notesFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:src="@drawable/ic_notes_pencil"
            android:contentDescription="New note"
            app:backgroundTint="@color/kittyFab"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- Notes lock view -->
        <LinearLayout
            android:id="@+id/notesLockView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/background"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_lock_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_lock_subtitle"
                android:textSize="13sp"
                android:textColor="@color/textSecondary"
                android:gravity="center"
                android:layout_marginTop="6dp" />

            <EditText
                android:id="@+id/lockPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/notes_lock_password_hint"
                android:inputType="textPassword"
                android:background="@drawable/bg_input_field"
                android:padding="14dp"
                android:layout_marginTop="20dp" />

            <TextView
                android:id="@+id/lockError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/notes_lock_error"
                android:textColor="@color/kittyError"
                android:textSize="13sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lockUnlockButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/notes_unlock"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/notesNavView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface"
        app:headerLayout="@layout/nav_header_kitty"
        app:itemIconTint="@color/kittyAccent"
        app:menu="@menu/notes_drawer_menu"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</androidx.drawerlayout.widget.DrawerLayout>
